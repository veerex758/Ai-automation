{
  "schedules": {
    "workflow-scheduler-tick": {
      "schedule": "*/30 * * * *",
      "path": "/api/internal/scheduler",
      "requestMethod": "POST",
      "timezone": "UTC"
    },
    "durable-worker-recovery": {
      "schedule": "0 * * * *",
      "path": "/api/internal/worker",
      "requestMethod": "POST",
      "timezone": "UTC"
    }
  },
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
