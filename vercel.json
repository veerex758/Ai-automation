{
  "crons": [
    {
      "path": "/api/internal/scheduler",
      "schedule": "0 9 * * *"
    }
  ],
  "schedules": {
    "durable-worker-recovery": {
      "schedule": "*/30 * * * *",
      "path": "/api/internal/worker",
      "requestMethod": "POST",
      "timezone": "UTC"
    }
  },
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
