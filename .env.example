# Aivanta's dedicated Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=https://xymbwkegcpjxlgclqiop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-only AI workflow generation. Never expose these values with NEXT_PUBLIC_.
AIVANTA_AI_API_KEY=your_ai_provider_api_key_here
# Optional OpenAI-compatible endpoint/model overrides (HTTPS required in production).
# AIVANTA_AI_BASE_URL=https://api.openai.com/v1
# AIVANTA_AI_MODEL=gpt-4o-mini

# Server-only email integration. Keep live execution disabled until configured and tested.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Aivanta <hello@example.com>
# Comma-separated allowlist of approved live email recipients.
AIVANTA_LIVE_EMAIL_RECIPIENTS=owner@example.com
AIVANTA_LIVE_EXECUTION_ENABLED=false
# Provider actions require an explicit server allowlist in addition to workflow activation.
# Keep email.send_email as the only default; add openai.generate_text,gemini.generate_text,slack.send_message,http.request only after testing.
AIVANTA_LIVE_ENABLED_ACTIONS=email.send_email

## Outbound HTTP node. Exact host allowlist; optional JSON map of hostname -> Bearer key. Keep both server-only.
# AIVANTA_HTTP_ALLOWED_HOSTS=api.example.com,api.partner.example
# AIVANTA_HTTP_API_KEYS={"api.example.com":"replace_me","api.partner.example":"replace_me"}

# Workspace-scoped integration credentials are encrypted at rest with AES-256-GCM. Generate a dedicated 32-byte key\n# (for example: openssl rand -base64 32) and set it in Vercel for Preview and Production separately.\n# Do not reuse the webhook key or commit the real value.\nAIVANTA_CREDENTIALS_ENCRYPTION_KEY=base64_encoded_32_byte_key_here\n\n# Inbound webhook ingress. Keep these server-only and provision matching key versions for endpoint records.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
AIVANTA_WEBHOOK_ENCRYPTION_KEY=base64_encoded_32_byte_key_here
AIVANTA_WEBHOOK_SECRET_KEY_VERSION=v1

# Never commit real API keys, service-role keys, database passwords, or customer credentials.
