# Aivanta staging Supabase project (authoritative for Preview).
NEXT_PUBLIC_SUPABASE_URL=https://ygclofqxtztnynkljipj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-only AI workflow draft generation. Never expose these values with NEXT_PUBLIC_.
AIVANTA_AI_API_KEY=your_ai_provider_api_key_here
# Set to gemini to use a Google AI Studio key; OpenAI is the default.
# AIVANTA_AI_PROVIDER=gemini
# Optional OpenAI-compatible endpoint/model overrides (HTTPS required in production).
# For Gemini, leave BASE_URL unset to use Google's OpenAI-compatible endpoint.
# AIVANTA_AI_BASE_URL=https://api.openai.com/v1
# AIVANTA_AI_MODEL=gpt-4o-mini

# Server-only email integration. Keep live execution disabled until configured and tested.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Aivanta <hello@example.com>
# Comma-separated allowlist of approved live email recipients.
AIVANTA_LIVE_EMAIL_RECIPIENTS=owner@example.com
AIVANTA_LIVE_EXECUTION_ENABLED=false
# Provider actions require an explicit server allowlist in addition to workflow activation.
# Keep email.send_email as the only default; add other actions only after provider-specific testing.
AIVANTA_LIVE_ENABLED_ACTIONS=email.send_email

# Outbound HTTP node. Exact host allowlist; credentials remain workspace-scoped and encrypted.
# AIVANTA_HTTP_ALLOWED_HOSTS=api.example.com,api.partner.example

# Workspace-scoped integration credentials are encrypted at rest with AES-256-GCM. Google OAuth tokens use the same key unless GOOGLE_TOKEN_ENCRYPTION_KEY is set separately.
# Generate a dedicated 32-byte key locally (for example: openssl rand -base64 32).
# Configure it as a server-only Vercel Preview environment variable; never commit the real value.
AIVANTA_CREDENTIALS_ENCRYPTION_KEY=base64_encoded_32_byte_key_here
# Optional key-version marker used by versioned credential envelopes.
# AIVANTA_CREDENTIALS_KEY_VERSION=v1

# Google OAuth — enable Gmail API and Google Sheets API, configure the OAuth consent screen, and register the exact callback URI /api/integrations/google/callback in Google Cloud Console.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=https://your-app-domain.example/api/integrations/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# Inbound webhook ingress. Keep these server-only and use distinct encryption material.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
AIVANTA_WEBHOOK_ENCRYPTION_KEY=base64_encoded_32_byte_key_here
AIVANTA_WEBHOOK_SECRET_KEY_VERSION=v1

# Never commit real API keys, service-role keys, database passwords, or customer credentials.
