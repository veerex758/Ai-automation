# Aivanta's connected staging Supabase project only. Production must use a separately verified project.
NEXT_PUBLIC_SUPABASE_URL=https://ygclofqxtztnynkljipj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-only AI workflow generation. Never expose these values with NEXT_PUBLIC_.
# Gemini setup: set GEMINI_API_KEY in Vercel or use AIVANTA_AI_API_KEY as a provider-neutral override.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Optional provider-neutral override (takes precedence over GEMINI_API_KEY).
# AIVANTA_AI_API_KEY=your_ai_provider_api_key_here
# Gemini is the default provider via Google's OpenAI-compatible API. Keep the key server-only.
# Set AIVANTA_AI_API_KEY to a Google AI Studio API key.
# Optional provider/model overrides (OpenAI-compatible endpoint; HTTPS required in production).
# AIVANTA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AIVANTA_AI_MODEL=gemini-2.5-flash
# To use another compatible provider, set its HTTPS base URL and model here.

# Server-only email integration. Keep live execution disabled until configured and tested.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Aivanta <hello@example.com>
# Comma-separated allowlist of approved live email recipients.
AIVANTA_LIVE_EMAIL_RECIPIENTS=owner@example.com
AIVANTA_LIVE_EXECUTION_ENABLED=false

# Inbound webhook ingress. Keep these server-only and provision matching key versions for endpoint records.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Protect the internal worker endpoint. Configure only in server-side environments.
CRON_SECRET=your_random_cron_secret_here
# AIVANTA_WORKER_SECRET=your_random_worker_secret_here
AIVANTA_WORKER_ID=vercel-worker
AIVANTA_WEBHOOK_ENCRYPTION_KEY=base64_encoded_32_byte_key_here
AIVANTA_WEBHOOK_SECRET_KEY_VERSION=v1

# Never commit real API keys, service-role keys, database passwords, or customer credentials.
